# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
# Real MongoDB (recommended):  mongodb://localhost:27017   or an Atlas mongodb+srv:// URL
# In-memory, non-persistent dev mode (no MongoDB needed):  mongomock://
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=tally
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# Public URL of the website - used for links in emails
FRONTEND_URL=http://localhost:5173

# ---- Email (password reset, email verification, security notices) ----
# console = development only, prints emails to the server console
# resend  = https://resend.com (free tier) - set RESEND_API_KEY and a verified sender domain in EMAIL_FROM
# smtp    = any SMTP server (Gmail app password, Zoho, SES SMTP...)
EMAIL_PROVIDER=console
EMAIL_FROM=Tally <no-reply@yourdomain.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Require a verified email before uploading statements (recommended: true in production)
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFY_HOURS=48

# ---- Abuse protection ----
RATE_LIMIT_ENABLED=true
# true when running behind a reverse proxy / platform load balancer (Render, Railway, Nginx)
TRUST_PROXY_HEADERS=false

# Bump when you materially change the Privacy Policy or Terms (stored with each user's consent)
LEGAL_VERSION=2026-11-17
